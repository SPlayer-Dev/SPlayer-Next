{
  "extends": "./tsconfig.base.json",
  "include": [
    "src/env.d.ts",
    "src/**/*",
    "src/**/*.vue",
    "windows/**/*",
    "windows/**/*.vue",
    "electron/preload/*.d.ts",
    "shared/**/*"
  ],
  "compilerOptions": {
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "tsBuildInfoFile": "node_modules/.cache/tsconfig.web.tsbuildinfo",
    "paths": {
      "@/*": ["./src/*"],
      "@shared/*": ["./shared/*"],
      "@windows/*": ["./windows/*"]
    },
    "types": ["./auto-imports.d.ts", "./components.d.ts"]
  }
}
